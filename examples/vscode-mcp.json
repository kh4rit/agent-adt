{
  "inputs": [
    {
      "type": "promptString",
      "id": "sap-password",
      "description": "SAP password for the ABAP MCP server",
      "password": true
    }
  ],
  "servers": {
    "abap": {
      "type": "stdio",
      "command": "node",
      "args": ["C:\\tools\\abap-adt-mcp\\dist\\index.js"],
      "env": {
        "SAP_URL": "https://sap-dev.example.com:44300",
        "SAP_CLIENT": "100",
        "SAP_USER": "DEVELOPER",
        "SAP_PASSWORD": "${input:sap-password}",
        "SAP_ALLOW_SELF_SIGNED": "true"
      }
    }
  }
}
