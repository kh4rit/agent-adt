{
  "name": "abap-adt-mcp",
  "version": "0.1.0",
  "description": "ABAP Development Tools for AI agents: an MCP server exposing SAP ADT (search, read, write to transports, activate) to Copilot, Claude Code and other MCP clients",
  "main": "dist/index.js",
  "scripts": {
    "test": "tsc -p tsconfig.json && node --test dist/**/*.test.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "mcp",
    "copilot",
    "github-copilot",
    "claude-code",
    "model-context-protocol"
  ],
  "author": "Vasilii Kharitonov",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "abap-adt-api": "^8.4.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^5.9.3"
  },
  "bin": {
    "abap-adt-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/test"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kh4rit/agent-adt.git"
  },
  "homepage": "https://github.com/kh4rit/agent-adt#readme",
  "bugs": {
    "url": "https://github.com/kh4rit/agent-adt/issues"
  }
}
